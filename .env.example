# Copy to .env (make setup does this). Never commit .env: this repository is public.
# Read by server code only.

TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# mock | replay | camera
TACTO_SOURCE=mock

# Circuit solver: where `brew install libngspice` puts the library on Apple Silicon.
NGSPICE_LIBRARY_PATH=/opt/homebrew/lib/libngspice.dylib

# Models (see docs/tech-stack.md)
TACTO_HINT_MODEL=Qwen/Qwen3.5-9B
TACTO_STT_MODEL=openai/whisper-large-v3
TACTO_TTS_MODEL=hexgrad/Kokoro-82M

LOGIWEBCAM_USER=hackathon
LOGIWEBCAM_PASSWORD=<the password>
