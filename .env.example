# Copy to .env (make setup does this). Never commit .env: this repository is public.
# Read by server code only.

TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# mock | replay | camera
TACTO_SOURCE=mock

# Models (see docs/tech-stack.md)
TACTO_HINT_MODEL=Qwen/Qwen3.5-9B
TACTO_STT_MODEL=openai/whisper-large-v3
TACTO_TTS_MODEL=hexgrad/Kokoro-82M
