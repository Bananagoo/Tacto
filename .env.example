# Copy to .env (make setup does this). Never commit .env: this repository is public.
# Read by server code only.

# Voice reflections only (VOICE_ENABLED=1). Model names live in server/tacto/voice_models.py.
TOGETHER_API_KEY=
# 1 turns on spoken reflections; needs the key above and the network.
VOICE_ENABLED=0

# mock | replay | camera
TACTO_SOURCE=mock

# 0 leaves the camera's gain alone instead of calibrating it on the paper.
AUTO_BRIGHTNESS=1

# Circuit solver: where `brew install libngspice` puts the library on Apple Silicon.
NGSPICE_LIBRARY_PATH=/opt/homebrew/lib/libngspice.dylib

LOGIWEBCAM_USER=hackathon
LOGIWEBCAM_PASSWORD=<the password>
